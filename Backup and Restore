# scripts/backup.sh

#!/bin/bash
set -euo pipefail

DB_NAME="${DB_NAME:-hotel_db}"
BACKUP_DIR="${BACKUP_DIR:-./backups}"
TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
BACKUP_FILE="${BACKUP_DIR}/hotel_db_${TIMESTAMP}.dump"

mkdir -p "$BACKUP_DIR"

pg_dump -Fc "$DB_NAME" > "$BACKUP_FILE"

echo "Backup created: $BACKUP_FILE"

# scripts/restore.sh

#!/bin/bash
set -euo pipefail

BACKUP_FILE="${1:?Usage: ./scripts/restore.sh <backup-file>}"
RESTORE_DB="${RESTORE_DB:-hotel_db_restore}"

dropdb --if-exists "$RESTORE_DB"
createdb "$RESTORE_DB"

pg_restore \
  --dbname="$RESTORE_DB" \
  --exit-on-error \
  "$BACKUP_FILE"

echo "Restore completed successfully: $RESTORE_DB"

# README.md

# Hotel Booking Database Backup & Restore

## Backup

Run:
./scripts/backup.sh
The script creates a timestamped PostgreSQL dump under `./backups/`.

eg:
backups/hotel_db_20260904_182200.dump

## Restore

Run:

./scripts/restore.sh backups/hotel_db_20260904_182200.dump

This creates a fresh local database named:

hotel_db_restore


## Verify Restore

Check that the required tables exist:
psql hotel_db_restore -c "\dt"


Expected tables:

hotel_bookings
booking_events


Verify the table structure:
psql hotel_db_restore -c "\d hotel_bookings"
psql hotel_db_restore -c "\d booking_events"


If test data exists, compare row counts:

psql hotel_db -c "SELECT COUNT(*) FROM hotel_bookings;"
psql hotel_db_restore -c "SELECT COUNT(*) FROM hotel_bookings;"

psql hotel_db -c "SELECT COUNT(*) FROM booking_events;"
psql hotel_db_restore -c "SELECT COUNT(*) FROM booking_events;"

#The restore is successful when pg_restore completes without errors and the expected tables and data are present in hotel_db_restore.
#set -euo pipefail for safer scripts, timestamped backups for traceability, a fresh restore database to avoid overwriting production/local data, and verification by comparing schema/data with the source database.

