| Assignment requirement | Terraform implementation                      |
| ---------------------- | --------------------------------------------- |
| VPC                    |    aws_vpc                                    |
| Public subnets         |    aws_subnet.public                          |
| Private subnets        |    aws_subnet.private                         |
| ALB SG                 |    aws_security_group.alb                     |
| ECS SG                 |    aws_security_group.ecs                     |
| RDS SG                 |    aws_security_group.rds                     |
| ECS Cluster            |    aws_ecs_cluster                            |
| Fargate                |    aws_ecs_task_definition` + aws_ecs_service |
| Application container  | `nginx:latest`                                |
| ALB                    | `aws_lb`                                      |
| ALB → ECS              | `aws_lb_target_group` + listener              |
| PostgreSQL             | `aws_db_instance`                             |
| RDS private            | `publicly_accessible = false`                 |
| RDS only from ECS      | RDS SG allows only ECS SG                     |
__________________________________________________________________________

Terraform code :

main.tf 

# Step 1 - Using provider of AWS 

provider "aws"
{
  region="us-east-1"
}

# Step 2 creating VPC(Virtaul private) resource along with public and private subnets 


resource "aws_vpc" "awsvpc"
{
  cidr_block = "10.0.0.0/16"
  tags = {
    Name = "firstvpc"
  }
}

resource "aws_subnet" "public" {
  count             = 2  
  vpc_id            = aws_vpc.main.id
  cidr_block        = "10.0.${count.index + 1}.0/24"
  availability_zone = element(["ap-south-1a", "ap-south-1b"], count.index)
}

resource "aws_subnet" "private" {
  count             = 2
  vpc_id            = aws_vpc.main.id
  cidr_block        = "10.0.${count.index + 11}.0/24"
  availability_zone = element(["ap-south-1a", "ap-south-1b"], count.index)
}

resource "aws_internet_gateway" "igw" {
  vpc_id = aws_vpc.main.id
}

# Public route table
resource "aws_route_table" "public" {
  vpc_id = aws_vpc.main.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.igw.id
  }
}

resource "aws_route_table_association" "public" {
  count          = 2
  subnet_id      = aws_subnet.public[count.index].id
  route_table_id = aws_route_table.public.id
}

# Step 3 - ALB/ECS/RDS Security Group

resource "aws_security_group" "alb" {
  name   = "alb-sg"
  vpc_id = aws_vpc.main.id

  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_security_group" "ecs" {
  name   = "ecs-sg"
  vpc_id = aws_vpc.main.id

  ingress {
    from_port       = 80
    to_port         = 80
    protocol        = "tcp"
    security_groups = [aws_security_group.alb.id]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_security_group" "rds" {
  name   = "rds-sg"
  vpc_id = aws_vpc.main.id

  ingress {
    from_port       = 5432
    to_port         = 5432
    protocol        = "tcp"
    security_groups = [aws_security_group.ecs.id]
  }
}

# step 4 ECS cluster 

resource "aws_ecs_cluster" "app" {
  name = "app-cluster"
}

resource "aws_iam_role" "ecs_execution" {
  name = "ecs-execution-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = {
        Service = "ecs-tasks.amazonaws.com"
      }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "ecs_execution" {
  role       = aws_iam_role.ecs_execution.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
}

resource "aws_ecs_task_definition" "app" {
  family                   = "app-task"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"

  cpu    = "256"
  memory = "512"

  execution_role_arn = aws_iam_role.ecs_execution.arn

  container_definitions = jsonencode([{
    name  = "nginx"
    image = "nginx:latest"

    portMappings = [{
      containerPort = 80
      hostPort      = 80
    }]
  }])
}

resource "aws_ecs_service" "app" {
  name            = "app-service"
  cluster         = aws_ecs_cluster.app.id
  task_definition = aws_ecs_task_definition.app.arn

  desired_count = 2
  launch_type   = "FARGATE"

  network_configuration {
    subnets          = aws_subnet.private[*].id
    security_groups  = [aws_security_group.ecs.id]
    assign_public_ip = false
  }

  load_balancer {
    target_group_arn = aws_lb_target_group.app.arn
    container_name   = "nginx"
    container_port   = 80
  }

  depends_on = [aws_lb_listener.http]
}


#Step 5 - RDS

resource "aws_db_subnet_group" "db" {
  name       = "app-db-subnet-group"
  subnet_ids = aws_subnet.private[*].id
}

resource "aws_db_instance" "postgres" {
  identifier = "app-postgres"

  engine         = "postgres"
  engine_version = "16"

  instance_class    = "db.t3.micro"
  allocated_storage = 20

  db_name  = "appdb"
  username = "appuser"
  password = var.db_password

  port = 5432

  db_subnet_group_name   = aws_db_subnet_group.db.name
  vpc_security_group_ids = [aws_security_group.rds.id]

  # RDS is private
  publicly_accessible = false

  skip_final_snapshot = true
}

variable "db_password" {
  type      = string
  sensitive = true
}

output "alb_dns_name" {
  value = aws_lb.app.dns_name
}









